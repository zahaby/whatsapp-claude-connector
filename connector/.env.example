# Copy to connector/.env (macos/install.sh or windows\install.ps1 does this); keep it owner-only.

# Where the upstream Go bridge keeps its message store
WA_DB_PATH=~/whatsapp-mcp/whatsapp-bridge/store/messages.db
WA_BRIDGE_URL=http://127.0.0.1:8080/api

# ---- THE SEND SWITCH --------------------------------------------------------
# false (default): connector is read-only; the send tool does not exist.
# true: send_message tool appears; Claude must confirm each message with you.
# Change with macos/sending.sh on|off  (it restarts the services for you)
WHATSAPP_ALLOW_SEND=false

# ---- Remote (HTTP) mode -----------------------------------------------------
# 43-char random secret. Generate/rotate with macos/rotate-token.sh
MCP_AUTH_TOKEN=
# Public hostname served by the Cloudflare Tunnel, e.g. wa.example.com
MCP_PUBLIC_HOSTNAME=
MCP_HOST=127.0.0.1
MCP_PORT=8765
# Optional: comma-separated CIDRs allowed to call the connector (as seen by
# Cloudflare). Put Anthropic's published outbound IP ranges here for an extra
# layer. Leave empty to rely on the token alone.
MCP_ALLOWED_IPS=
# Local-only Unix socket used by connector/verify.py to check the running server
# (token required; IP allowlist not applied; unreachable through the tunnel).
# Default: connector/.run/admin.sock
MCP_ADMIN_SOCKET=
# Which local admin channel: unix (macOS/Linux default) | tcp (Windows default) | off
MCP_ADMIN_CHANNEL=
# tcp channel only: loopback port, never forwarded by the tunnel. Default MCP_PORT+1.
MCP_ADMIN_PORT=

# ---- Daily group summary (separate connector, off by default) --------------
# Managed with macos/daily-summary.sh or windows\daily-summary.ps1:
#   set "<group>", on, off, url, rotate, status
WHATSAPP_AUTOPOST=false
# The one chat it may read and post to (a chat JID, set by "daily-summary set")
WA_AUTOPOST_CHAT=
# Its own secret for https://<host>/daily/<token> (created by "daily-summary on")
MCP_DAILY_TOKEN=
# Limits: posts per 24 hours, minimum minutes between posts, max characters per post
WA_AUTOPOST_MAX_PER_DAY=2
WA_AUTOPOST_MIN_GAP_MINUTES=60
WA_AUTOPOST_MAX_CHARS=7000
# End each summary with every member's share of the messages (counted by the connector).
WA_AUTOPOST_PARTICIPATION=true

# ---- Links and media (media.py) --------------------------------------------
# Links / YouTube captions: on (fetches public pages only, when asked)
WA_LINKS=true
# Local transcription of WhatsApp videos and voice notes: switch with
# macos/media-setup.sh / windows\media-setup.ps1 (installs ~1.5 GB once)
WA_MEDIA=false
WA_WHISPER_MODEL=medium
WA_MEDIA_MAX_MINUTES=20
# Chats to pre-process in the background (the daily-summary group always is)
WA_MEDIA_CHATS=
