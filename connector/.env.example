# Copy to connector/.env (macos/install.sh does this) and keep it chmod 600.

# Where the upstream Go bridge keeps its message store
WA_DB_PATH=~/whatsapp-mcp/whatsapp-bridge/store/messages.db
WA_BRIDGE_URL=http://127.0.0.1:8080/api

# ---- THE SEND SWITCH --------------------------------------------------------
# false (default): connector is read-only; the send tool does not exist.
# true: send_message tool appears; Claude must confirm each message with you.
# Change with macos/sending.sh on|off  (it restarts the services for you)
WHATSAPP_ALLOW_SEND=false

# ---- Remote (HTTP) mode -----------------------------------------------------
# 43-char random secret. Generate/rotate with macos/rotate-token.sh
MCP_AUTH_TOKEN=
# Public hostname served by the Cloudflare Tunnel, e.g. wa.example.com
MCP_PUBLIC_HOSTNAME=
MCP_HOST=127.0.0.1
MCP_PORT=8765
# Optional: comma-separated CIDRs allowed to call the connector (as seen by
# Cloudflare). Put Anthropic's published outbound IP ranges here for an extra
# layer. Leave empty to rely on the token alone.
MCP_ALLOWED_IPS=
# Local-only Unix socket used by connector/verify.py to check the running server
# (token required; IP allowlist not applied; unreachable through the tunnel).
# Default: connector/.run/admin.sock
MCP_ADMIN_SOCKET=
