#!/usr/bin/env bash
# Test double for macOS launchctl. Tracks "loaded" services in $STUB_STATE and
# runs the REAL connector server for com.wa.connector, so scripts can be
# checked against a live process. Failure modes via env:
#   STUB_KICKSTART=fail   kickstart exits non-zero
#   STUB_KICKSTART=noop   kickstart "succeeds" but restarts nothing
#   STUB_BOOTSTRAP=fail   bootstrap exits non-zero
set -u
st="$STUB_STATE"
echo "$*" >> "$st/calls"
cmd="$1"; shift

start_conn() {
  WA_CONFIG="$WA_ENV_FILE" "$WA_PYTHON" "$STUB_REPO/connector/server.py" --transport http \
    >> "$st/connector.log" 2>&1 &
  echo $! > "$st/com.wa.connector.pid"
}
# A process counts as alive only if it exists AND is not a zombie. Zombies
# still pass `kill -0`; in containers whose PID 1 does not reap orphans they
# never go away, which used to hang this stub forever.
alive() {
  kill -0 "$1" 2>/dev/null || return 1
  command -v ps >/dev/null 2>&1 || return 0
  case "$(ps -o stat= -p "$1" 2>/dev/null | tr -d ' ')" in
    Z*|"") return 1 ;;
  esac
  return 0
}
wait_gone() {   # wait_gone PID SECONDS; returns 1 on timeout
  # Deadline on the wall clock ($SECONDS, bash 3.2-safe), not a tick count:
  # each `alive` check forks ps, which is slow on macOS runners, so a fixed
  # number of ticks could take several times longer than intended.
  local deadline=$((SECONDS + $2))
  while alive "$1"; do
    [ "$SECONDS" -ge "$deadline" ] && return 1
    sleep 0.05
  done
}
stop_conn() {
  local f="$st/com.wa.connector.pid" pid
  [ -f "$f" ] || return 0
  pid="$(cat "$f")"; rm -f "$f"
  kill "$pid" 2>/dev/null || return 0
  wait_gone "$pid" 5 && return 0                 # 5s for a graceful stop
  echo "stub launchctl: $pid ignored SIGTERM, sending SIGKILL" >&2
  kill -9 "$pid" 2>/dev/null || true
  wait_gone "$pid" 2 || echo "stub launchctl: $pid still present after SIGKILL" >&2
  return 0
}

case "$cmd" in
  print)
    l="$(basename "$1")"
    [ -f "$st/$l.loaded" ] || { echo "Could not find service \"$l\"" >&2; exit 113; }
    echo "$1 = {"
    if [ -f "$st/$l.pid" ] && alive "$(cat "$st/$l.pid")"; then
      printf '\tpid = %s\n' "$(cat "$st/$l.pid")"
    fi
    echo "}" ;;
  kickstart)
    [ "$1" = "-k" ] && shift
    l="$(basename "$1")"
    [ -f "$st/$l.loaded" ] || { echo "Could not find service" >&2; exit 113; }
    case "${STUB_KICKSTART:-ok}" in
      fail) echo "Could not kickstart service: Operation not permitted" >&2; exit 150 ;;
      noop) exit 0 ;;
    esac
    if [ "$l" = com.wa.connector ]; then stop_conn; start_conn; fi ;;
  bootstrap)
    [ "${STUB_BOOTSTRAP:-ok}" = fail ] && { echo "Bootstrap failed: 5: Input/output error" >&2; exit 5; }
    l="$(basename "$2" .plist)"
    touch "$st/$l.loaded"
    if [ "$l" = com.wa.connector ]; then start_conn; fi ;;
  bootout)
    l="$(basename "$1")"
    rm -f "$st/$l.loaded"
    if [ "$l" = com.wa.connector ]; then stop_conn; fi ;;
  *) echo "stub launchctl: unsupported $cmd" >&2; exit 64 ;;
esac
exit 0
